# Porta do servidor principal (HTTP = PORT, HTTPS = PORT+1)
PORT=3000

# Porta do gameserver (HTTP = PORT, HTTPS = PORT+1)
# GAMESERVER_PORT=4000

# String de conexao do Postgres
POSTGRES=postgres://postgres@localhost/bombermanos

# Origins permitidos no CORS (separados por virgula)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Segredo da sessao (troque em producao)
SESSION_SECRET=change-me-in-production
